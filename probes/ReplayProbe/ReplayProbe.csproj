<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ReplayProbe</RootNamespace>

    <!-- Test harness, not shipped: keeps dotnet pack on the solution from emitting a package for it. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Three client stacks, each speaking TDS its own way: ADO.NET, EF Core on top of it, and ODBC. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.5" />
    <PackageReference Include="System.Data.Odbc" Version="10.0.5" />
  </ItemGroup>

</Project>
